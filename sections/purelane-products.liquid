<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section
  id="PurelaneProducts-{{ section.id }}"
  class="purelane-products"
  data-purelane-scene="3"
>
  <div class="purelane-products__container">

    <div class="purelane-products__header">
      {% if section.settings.kicker != blank %}
        <span class="purelane-products__kicker">
          {{ section.settings.kicker }}
        </span>
      {% endif %}

      <h2>
        {{ section.settings.heading }}
      </h2>

      <div class="purelane-products__rule">
        <span></span>
        <span>✦</span>
        <span></span>
      </div>
    </div>

    {% if section.settings.collection != blank %}
      <div class="purelane-products__grid">
        {% for product in section.settings.collection.products
          limit: section.settings.products_to_show
        %}
          {% render 'purelane-product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p>
        Select a collection in the theme editor.
      </p>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Purelane product grid",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Purelane product grid"
    }
  ]
}
{% endschema %}
