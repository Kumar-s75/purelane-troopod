<section
  id="PurelaneHero-{{ section.id }}"
  class="purelane-hero"
  data-purelane-scene="1"
>
  <div class="purelane-chrome">
    <div class="purelane-chrome__ticker" aria-label="Store benefits">
      <div class="purelane-chrome__ticker-track">
        {% for repeat in (1..2) %}
          <span>{{ section.settings.ticker_first }}</span>
          <span>{{ section.settings.ticker_second }}</span>
          <span>{{ section.settings.ticker_third }}</span>
          <span>{{ section.settings.ticker_fourth }}</span>
        {% endfor %}
      </div>
    </div>

    <header class="purelane-chrome__header">
      <div class="purelane-chrome__navpill">
        <a class="purelane-chrome__brand" href="#PurelaneHero-{{ section.id }}" aria-label="{{ shop.name | escape }} home">
          <span class="purelane-chrome__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/><path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/></svg>
          </span>
          <span class="purelane-chrome__brand-copy"><strong>{{ section.settings.brand_name | default: shop.name }}</strong><small>{{ section.settings.brand_tagline }}</small></span>
        </a>

        <nav class="purelane-chrome__menu" aria-label="Primary navigation">
          {% if section.settings.menu != blank %}
            {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
          {% else %}
            <a href="#PurelaneHero-{{ section.id }}">Home</a>
            <a href="#PurelaneReviews-purelane_reviews">Ingredients</a>
            <a href="#PurelaneBundles-purelane_bundles">How it works</a>
            <a href="#PurelaneProducts-purelane_products">Shop</a>
            <a href="#PurelaneBundles-purelane_bundles">Bundles</a>
          {% endif %}
        </nav>

        <div class="purelane-chrome__tools">
          <a class="purelane-chrome__icon purelane-chrome__icon--desktop" href="{{ routes.search_url }}" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></a>
          <a class="purelane-chrome__icon purelane-chrome__icon--desktop" href="{{ routes.account_url }}" aria-label="Account"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg></a>
          <a class="purelane-chrome__icon" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg><span class="purelane-chrome__cart-count">{{ cart.item_count }}</span></a>
          <a class="purelane-chrome__icon purelane-chrome__menu-button" href="{{ routes.all_products_collection_url }}" aria-label="Browse products"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg></a>
        </div>
      </div>
    </header>
  </div>

  <div class="purelane-hero__grid">

    <div class="purelane-hero__badges" aria-label="Product promises">
      <div class="purelane-hero__badge">
        <span class="purelane-hero__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
        <span>{{ section.settings.promise_1 | default: 'Plant powered' | newline_to_br }}</span>
      </div>

      <div class="purelane-hero__badge">
        <span class="purelane-hero__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg></span>
        <span>{{ section.settings.promise_2 | default: 'Safe for kids & pets' | newline_to_br }}</span>
      </div>

      <div class="purelane-hero__badge">
        <span class="purelane-hero__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg></span>
        <span>{{ section.settings.promise_3 | default: 'Zero harsh chemicals' | newline_to_br }}</span>
      </div>
    </div>

    <div class="purelane-hero__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="purelane-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h1>
        {{ section.settings.heading_line_1 }}<br>
        {{ section.settings.heading_line_2 }}<br>
        <span>{{ section.settings.heading_line_3 }}</span>
      </h1>

      <div class="purelane-hero__rule" aria-hidden="true">
        <i></i>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
        <i></i>
      </div>

      <p class="purelane-hero__lede">
        {{ section.settings.description }}
      </p>

      <div class="purelane-hero__actions">
        <a
          href="{{ section.settings.primary_link }}"
          class="purelane-hero__button purelane-hero__button--primary"
        >
          {{ section.settings.primary_label }}
          <span aria-hidden="true">→</span>
        </a>

        <a
          href="{{ section.settings.secondary_link }}"
          class="purelane-hero__button purelane-hero__button--secondary"
        >
          {{ section.settings.secondary_label }}
        </a>
      </div>

      <div class="purelane-hero__mobile-badges">
        <span>✦ {{ section.settings.promise_1 | default: 'Plant powered' | replace: '\n', ' ' }}</span>
        <span>✓ {{ section.settings.promise_2 | default: 'Kids & pet safe' | replace: '\n', ' ' }}</span>
        <span>○ {{ section.settings.promise_3 | default: 'Zero harsh chem' | replace: '\n', ' ' }}</span>
      </div>
    </div>

    <div class="purelane-hero__products">

      {% assign hero_products = section.settings.hero_collection.products %}

      {% for slide_number in (1..3) %}
        {% if hero_products.size >= slide_number %}
          {% assign total_price = 0 %}
          {% assign total_compare_price = 0 %}
        <article
          class="purelane-hero__slide{% if forloop.first %} is-active{% endif %}"
          data-hero-slide="{{ forloop.index0 }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
        >
          <div class="purelane-hero__product-stage">
            {% for product in hero_products limit: slide_number %}
              {% assign total_price = total_price | plus: product.price %}
              {% if product.compare_at_price > product.price %}
                {% assign total_compare_price = total_compare_price | plus: product.compare_at_price %}
              {% else %}
                {% assign total_compare_price = total_compare_price | plus: product.price %}
              {% endif %}
              <div class="purelane-hero__product-image purelane-hero__product-image--{{ forloop.index }}">
            {% if product.featured_image %}
              {% liquid
                assign image_loading = 'lazy'
                assign image_fetchpriority = 'auto'
                if slide_number == 1
                  assign image_loading = 'eager'
                  assign image_fetchpriority = 'high'
                endif
              %}
              {{
                product.featured_image
                | image_url: width: 900
                | image_tag:
                  loading: image_loading,
                  fetchpriority: image_fetchpriority,
                  widths: '400, 600, 800, 900',
                  sizes: '(min-width: 990px) 45vw, 90vw',
                  alt: product.featured_image.alt | default: product.title
              }}
            {% else %}
              <div class="purelane-hero__placeholder">
                PURELANE
              </div>
            {% endif %}
              </div>
            {% endfor %}
          </div>

          <div class="purelane-hero__price-card">
            <span class="purelane-hero__price-label">
              {% if slide_number == 1 %}
                Single bottle
              {% elsif slide_number == 2 %}
                Any 2 products
              {% else %}
                Any 3 products
              {% endif %}
            </span>

            <div class="purelane-hero__prices">
              <strong>
                {{ total_price | money }}
              </strong>

              {% if total_compare_price > total_price %}
                <s>
                  {{ total_compare_price | money }}
                </s>
              {% endif %}
            </div>

            {% if total_compare_price > total_price %}
              <span class="purelane-hero__saving">
                {{ total_compare_price
                  | minus: total_price
                  | times: 100.0
                  | divided_by: total_compare_price
                  | round
                }}% off
              </span>
            {% endif %}
          </div>
        </article>
        {% endif %}
      {% endfor %}

      {% if hero_products.size > 0 %}
        <div class="purelane-hero__dots" aria-label="Hero product slides">
          {% for slide_number in (1..3) %}
            {% if hero_products.size >= slide_number %}
            <button
              type="button"
              class="{% if forloop.first %}is-active{% endif %}"
              data-hero-dot="{{ forloop.index0 }}"
              aria-label="Show {{ slide_number }} product{% if slide_number > 1 %}s{% endif %}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

    </div>

  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('PurelaneHero-{{ section.id }}');

    if (!root || root.dataset.initialized === 'true') return;

    root.dataset.initialized = 'true';

    const slides = [...root.querySelectorAll('[data-hero-slide]')];
    const dots = [...root.querySelectorAll('[data-hero-dot]')];

    if (slides.length < 2) return;

    let current = 0;
    let timer;

    const showSlide = (index) => {
      current = index;

      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === index);
        slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-pressed', i === index ? 'true' : 'false');
      });
    };

    const start = () => {
      clearInterval(timer);

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
      }

      timer = setInterval(() => {
        showSlide((current + 1) % slides.length);
      }, 4500);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        showSlide(index);
        start();
      });
    });

    root.addEventListener('mouseenter', () => clearInterval(timer));
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', () => clearInterval(timer));
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget)) start();
    });

    const stopOnSectionUnload = (event) => {
      if (event.target !== root) return;
      clearInterval(timer);
      document.removeEventListener('shopify:section:unload', stopOnSectionUnload);
    };

    document.addEventListener('shopify:section:unload', stopOnSectionUnload);

    start();
  })();
</script>

