<section id="PurelaneCombos-{{ section.id }}" class="purelane-section purelane-combos" data-purelane-scene="3" aria-labelledby="PurelaneCombosTitle-{{ section.id }}">
  <div class="purelane-combos__container">
    <header class="purelane-combos__header">
      {% if section.settings.kicker != blank %}<p class="purelane-combos__kicker">{{ section.settings.kicker }}</p>{% endif %}
      <h2 id="PurelaneCombosTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      <div class="purelane-combos__rule" aria-hidden="true"><span></span><b>✦</b><span></span></div>
      {% if section.settings.description != blank %}<p>{{ section.settings.description }}</p>{% endif %}
    </header>

    <div class="purelane-combos__rail" tabindex="0" role="region" aria-label="Best-selling combos. Scroll horizontally to browse.">
      {% for block in section.blocks %}
        {% liquid
          assign bundle_product = block.settings.bundle_product
          assign combo_products = block.settings.products
          if combo_products == blank
            assign combo_products = collections.all.products
          endif
          assign product_count = block.settings.products | size
          if product_count == 0
            assign product_count = block.settings.fallback_product_count
          endif
          assign link = block.settings.link | default: bundle_product.url | default: routes.all_products_collection_url
          assign saving = blank
          if bundle_product != blank and bundle_product.compare_at_price > bundle_product.price
            assign saving = bundle_product.compare_at_price | minus: bundle_product.price | money
          endif
        %}
        <article class="purelane-combo{% if block.settings.featured %} purelane-combo--featured{% endif %}" {{ block.shopify_attributes }}>
          <div class="purelane-combo__tray">
            {% if block.settings.badge != blank %}<span class="purelane-combo__badge">{{ block.settings.badge }}</span>{% endif %}
            {% if block.settings.flag != blank %}
              <span class="purelane-combo__flag">{{ block.settings.flag }}</span>
            {% elsif block.settings.featured %}
              <span class="purelane-combo__flag">{{ block.settings.featured_label }}</span>
            {% endif %}
            <div class="purelane-combo__product-list">
              {% for product in combo_products limit: product_count %}
                <div class="purelane-combo__product">
                  {% if product.featured_image %}
                    {{ product.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', alt: product.featured_image.alt | default: product.title }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'purelane-combo__product-placeholder' }}
                  {% endif %}
                  <span>{{ product.title | truncate: 28 }}</span>
                </div>
                {% unless forloop.last %}<span class="purelane-combo__plus" aria-hidden="true">+</span>{% endunless %}
              {% endfor %}
            </div>
          </div>
          <div class="purelane-combo__body">
            <h3>{{ block.settings.title }}</h3>
            <span class="purelane-combo__count">{{ product_count }} products</span>
            {% if block.settings.description != blank %}<p class="purelane-combo__description">{{ block.settings.description }}</p>{% endif %}
            <div class="purelane-combo__price">
              {% if bundle_product != blank %}
                <strong>{{ bundle_product.price | money }}</strong>
                {% if bundle_product.compare_at_price > bundle_product.price %}<s>{{ bundle_product.compare_at_price | money }}</s><em>Save {{ saving }}</em>{% endif %}
              {% else %}
                <strong>{{ block.settings.price }}</strong>
                {% if block.settings.compare_price != blank %}<s>{{ block.settings.compare_price }}</s>{% endif %}
                {% if block.settings.savings != blank %}<em>{{ block.settings.savings }}</em>{% endif %}
              {% endif %}
            </div>
            <p class="purelane-combo__fine">{{ section.settings.fine_print }}</p>
            <a class="purelane-button {% if block.settings.featured %}purelane-button--primary{% else %}purelane-button--secondary{% endif %}" href="{{ link }}">{{ block.settings.button_label }} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      {% endfor %}
    </div>
    {% if section.settings.swipe_label != blank %}<p class="purelane-combos__swipe" aria-hidden="true">→ {{ section.settings.swipe_label }}</p>{% endif %}
    {% if section.settings.note != blank %}<p class="purelane-combos__note">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Inclusive of all taxes · COD available" },
    { "type": "text", "id": "swipe_label", "label": "Swipe cue", "default": "Swipe for more combos" },
    { "type": "textarea", "id": "note", "label": "Supporting note", "default": "Select a bundle product to show its live Shopify price and compare-at price." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen essentials" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Everything you need for a sparkling kitchen, no need to pick separately." },
        { "type": "product_list", "id": "products", "label": "Products shown", "limit": 5 },
        { "type": "range", "id": "fallback_product_count", "label": "Fallback product count", "min": 1, "max": 5, "step": 1, "default": 3, "info": "Used when Products shown is empty." },
        { "type": "product", "id": "bundle_product", "label": "Bundle product", "info": "Select a real bundle product to show live Shopify pricing." },
        { "type": "text", "id": "price", "label": "Fallback price", "default": "₹499", "info": "Shown only when no bundle product is selected." },
        { "type": "text", "id": "compare_price", "label": "Fallback compare-at price", "default": "₹897" },
        { "type": "text", "id": "savings", "label": "Fallback savings", "default": "Save ₹398" },
        { "type": "text", "id": "badge", "label": "Savings badge", "default": "You save ₹398" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop bundle" },
        { "type": "url", "id": "link", "label": "Button link", "info": "Overrides the selected bundle product URL." },
        { "type": "checkbox", "id": "featured", "label": "Featured combo", "default": false },
        { "type": "text", "id": "flag", "label": "Corner flag", "info": "Optional flag such as Most popular." },
        { "type": "text", "id": "featured_label", "label": "Featured label", "default": "Best value" }
      ]
    }
  ],
  "presets": [{ "name": "Purelane combos", "blocks": [{ "type": "combo" }, { "type": "combo", "settings": { "title": "Laundry care bundle" } }, { "type": "combo", "settings": { "title": "Complete home bundle", "featured": true } }] }]
}
{% endschema %}
